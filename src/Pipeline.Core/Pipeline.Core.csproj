<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Patware.Pipeline.Core</PackageId>
    <Authors>Patware</Authors>
    <Description>Build composable, typed workflow graphs for .NET with dependencies, conditions, and polling.</Description>
    <PackageTags>pipeline;dotnet</PackageTags>
    <PackageReleaseNotes>0.3.0: Aligned with the distributed-hosting package family. Graph construction, versioned requests, and step context/logging contracts remain separate from transport monitoring contracts.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/patware/Patware.Pipeline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/patware/Patware.Pipeline</RepositoryUrl>
    <Copyright>Copyright (c) 2026 Patrice Calvé</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
