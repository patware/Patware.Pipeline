<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Patware.Pipeline.HttpClient</PackageId>
    <Authors>Patware</Authors>
    <Description>HTTP client integration for remote pipeline monitoring.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/patware/Patware.Pipeline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience"
                      Version="10.10.0" />
  </ItemGroup>
  
<ItemGroup>
    <ProjectReference Include="..\Pipeline.Contracts\Pipeline.Contracts.csproj" />
  </ItemGroup>

</Project>  
 