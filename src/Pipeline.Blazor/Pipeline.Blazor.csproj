<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Patware.Pipeline.Blazor</PackageId>
    <Authors>Patware</Authors>
    <Description>Bring .NET workflows into view with Blazor pages for pipeline run history, job and step progress, formatted logs, and retry controls.</Description>
    <PackageTags>pipeline;dotnet;blazor</PackageTags>
    <PackageReleaseNotes>Initial release with Blazor Interactive Server pages and components for displaying workflow run history, job and step progress, polling countdowns, periodically refreshed execution state, scoped log filtering, ANSI-formatted logs, and retry-from-failure controls. Pipeline Runs includes a Jobs column with individual job status icons, direct links to job logs, descriptive tooltips, screen-reader labels, and running animations that respect reduced-motion preferences.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/patware/Patware.Pipeline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/patware/Patware.Pipeline</RepositoryUrl>
    <Copyright>Copyright (c) 2026 Patrice Calvé</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pipeline.Contracts\Pipeline.Contracts.csproj" />
  </ItemGroup>

</Project>
