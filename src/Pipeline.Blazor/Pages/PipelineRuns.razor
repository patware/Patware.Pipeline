@page "/pipeline-runs"
@rendermode InteractiveServer
@inherits LivePipelinePage

@using Pipeline.Blazor.Components

<PageTitle>Pipeline runs</PageTitle>

<h1>Pipeline runs</h1>

<p class="text-muted">
    Showing @_runs.Count of the latest 50 runs.
    Refreshes every 20 seconds.
</p>

@if (_runs.Count == 0)
{
    <p>No pipeline runs yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Run</th>
                    <th scope="col">Pipeline</th>
                    <th scope="col">Created</th>
                    <th scope="col">Created by</th>
                    <th scope="col">Status</th>
                    <th scope="col">Jobs</th>
                    <th scope="col">Progress</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in _runs)
                {
                    <tr @key="run.Id">
                        <td>
                            <a href="@($"pipeline-runs/{run.Id}")">
                                @run.Title
                            </a>
                            <div class="small text-muted">@run.Id</div>
                        </td>
                        <td>@run.Definition.DisplayName</td>
                        <td>
                            @run.CreatedAt.ToLocalTime().ToString("g")
                        </td>
                        <td>@run.CreatedBy</td>
                        <td>@run.Status</td>
                        <td><PipelineJobStatuses Jobs="@_jobsByRun[run.Id]"/></td>
                        <td>@run.StatusText</td>
                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
