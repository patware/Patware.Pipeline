@page "/pipeline-runs"
@rendermode InteractiveServer
@inherits LivePipelinePage

<PageTitle>Pipeline runs</PageTitle>

<h1>Pipeline runs</h1>

<p class="text-muted">
    Showing @runs.Count of the latest 50 runs.
    Refreshes every 20 seconds.
</p>

@if (runs.Count == 0)
{
    <p>No pipeline runs yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Run</th>
                    <th scope="col">Pipeline</th>
                    <th scope="col">Created</th>
                    <th scope="col">Created by</th>
                    <th scope="col">Status</th>
                    <th scope="col">Progress</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in runs)
                {
                    <tr @key="run.Id">
                        <td>
                            <a href="@($"pipeline-runs/{run.Id}")">
                                @run.Title
                            </a>
                            <div class="small text-muted">@run.Id</div>
                        </td>
                        <td>@run.Definition.DisplayName</td>
                        <td>
                            @run.CreatedAt.ToLocalTime().ToString("g")
                        </td>
                        <td>@run.CreatedBy</td>
                        <td>@run.Status</td>
                        <td>@run.StatusText</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<global::Pipeline.Runtime.PipelineRun> runs = [];

    /// <summary>Loads the fifty most recently created runs for the overview page.</summary>
    /// <param name="cancellationToken">The token used to cancel snapshot loading.</param>
    /// <returns>A task that completes after the run list is updated.</returns>
    protected override async Task LoadSnapshotAsync(
        CancellationToken cancellationToken)
    {
        runs = await Runtime.GetRunsAsync(
            skip: 0,
            take: 50,
            cancellationToken: cancellationToken);
    }
}
