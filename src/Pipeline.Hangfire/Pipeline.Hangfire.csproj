<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Patware.Pipeline.Hangfire</PackageId>
    <Version>0.1.0</Version>
    <Authors>Patware</Authors>
    <Description>Power .NET workflows with Hangfire processing, scheduled polling, and recovery of unfinished pipeline runs using in-memory or SQL Server storage.</Description>
    <PackageTags>pipeline;dotnet;hangfire;background-jobs;workflow</PackageTags>
    <RepositoryUrl>https://github.com/patware/Patware.Pipeline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pipeline.Runtime\Pipeline.Runtime.csproj" />
  </ItemGroup>

</Project>
