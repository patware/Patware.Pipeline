<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Patware.Pipeline.Persistence.EntityFrameworkCore</PackageId>
    <Authors>Patware</Authors>
    <Description>Persist .NET workflow history and execution state in SQL Server with Entity Framework Core persistence for pipeline runs, step outputs, and logs.</Description>
    <PackageTags>pipeline;dotnet;entityframeworkcore;sqlserver;persistence</PackageTags>
    <RepositoryUrl>https://github.com/patware/Patware.Pipeline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pipeline.Runtime\Pipeline.Runtime.csproj" />
  </ItemGroup>

</Project>
