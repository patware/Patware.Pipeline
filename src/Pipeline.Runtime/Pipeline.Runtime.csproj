<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Patware.Pipeline.Runtime</PackageId>
    <Authors>Patware</Authors>
    <Description>The runtime for the composable pipeline library for .NET.</Description>
    <PackageTags>pipeline;dotnet</PackageTags>
    <PackageReleaseNotes>Initial release with dependency injection registration, queued workflow execution through a built-in background worker, in-memory persistence, run and step queries, execution logs, versioned workflow restoration, and retry while preserving successful work. Includes asynchronous, process-local lifecycle notifications for queued, started, completed, failed, and retried runs through application-defined scoped handlers. Notifications are published after successful persistence and support both the built-in processor and Hangfire. Delivery is best-effort, without durable storage or automatic handler retries. Includes invocation-scoped pipeline context injection, initialized before step construction using persisted run metadata.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/patware/Patware.Pipeline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/patware/Patware.Pipeline</RepositoryUrl>
    <Copyright>Copyright (c) 2026 Patrice Calvé</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pipeline.Core\Pipeline.Core.csproj" />
  </ItemGroup>

</Project>
